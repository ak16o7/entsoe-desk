# Copy this file to .env for local use. Never commit .env.
ENTSOE_API_KEY=PASTE_YOUR_TOKEN_HERE

# Optional: protect the whole dashboard with HTTP Basic Auth.
# Leave both empty to disable authentication locally.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional overrides
ENTSOE_ENDPOINT_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_REFRESH_SECONDS=300
ENTSOE_CACHE_SECONDS=240
ENTSOE_CACHE_MAX_ENTRIES=256
ENTSOE_HTTP_TIMEOUT=35
ENTSOE_MAX_REQUESTS_PER_MINUTE=300
PORT=8000
